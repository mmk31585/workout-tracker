# Database Configuration
# Local dev connects through the published host port 5438 -> container 5432 (see docker-compose.yml)
DB_ADDR=postgres://workout:workout@localhost:5438/workout?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_LIFE_TIME=5m

# Postgres DB Configuration (consumed by docker-compose)
POSTGRES_DB=workout
POSTGRES_USER=workout
POSTGRES_PASSWORD=workout

# Log Configuration
LOG_LEVEL=debug
LOG_FORMAT=text

# JWT Configuration
# Generate your own secret: openssl rand -base64 32
JWT_SECRET=change-me-generate-your-own-with-openssl-rand-base64-32
JWT_EXPIRATION=1h

# Server Configuration
HTTP_PORT=8080
HTTP_HOST=0.0.0.0

# Application Settings
APP_NAME=Workout Tracker
APP_ENV=development

# Basic Authentication (for HTTP Basic Auth middleware)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=password